{
  "providers": {
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "https://api.openai.com/v1",
      "organization_id": "${OPENAI_ORG_ID}",
      "rate_limit": 60,
      "models": {
        "gpt-4o": {
          "context_length": 128000,
          "cost_per_1k_tokens": {"input": 0.005, "output": 0.015},
          "capabilities": ["text", "vision", "function_calling"]
        },
        "gpt-4-turbo": {
          "context_length": 128000,
          "cost_per_1k_tokens": {"input": 0.01, "output": 0.03},
          "capabilities": ["text", "vision", "function_calling"]
        },
        "gpt-3.5-turbo": {
          "context_length": 16385,
          "cost_per_1k_tokens": {"input": 0.0015, "output": 0.002},
          "capabilities": ["text", "function_calling"]
        }
      }
    },
    "anthropic": {
      "api_key": "${ANTHROPIC_API_KEY}",
      "base_url": "https://api.anthropic.com/v1",
      "rate_limit": 50,
      "models": {
        "claude-3-5-sonnet-20241022": {
          "context_length": 200000,
          "cost_per_1k_tokens": {"input": 0.003, "output": 0.015},
          "capabilities": ["text", "vision", "analysis"]
        },
        "claude-3-opus-20240229": {
          "context_length": 200000,
          "cost_per_1k_tokens": {"input": 0.015, "output": 0.075},
          "capabilities": ["text", "vision", "creative_writing"]
        },
        "claude-3-haiku-20240307": {
          "context_length": 200000,
          "cost_per_1k_tokens": {"input": 0.00025, "output": 0.00125},
          "capabilities": ["text", "speed", "efficiency"]
        }
      }
    },
    "vertex_ai": {
      "project_id": "${GOOGLE_CLOUD_PROJECT}",
      "location": "us-central1",
      "credentials_path": "${GOOGLE_APPLICATION_CREDENTIALS}",
      "rate_limit": 40,
      "models": {
        "gemini-pro": {
          "context_length": 32768,
          "cost_per_1k_tokens": {"input": 0.0005, "output": 0.0015},
          "capabilities": ["text", "multimodal"]
        },
        "gemini-pro-vision": {
          "context_length": 16384,
          "cost_per_1k_tokens": {"input": 0.0025, "output": 0.01},
          "capabilities": ["text", "vision", "multimodal"]
        }
      }
    }
  },
  "routing": {
    "default_strategy": "intelligent_hybrid",
    "fallback_enabled": true,
    "max_retries": 3,
    "timeout_seconds": 30,
    "strategies": {
      "round_robin": {
        "description": "Distribute requests evenly across providers"
      },
      "lowest_latency": {
        "description": "Route to fastest responding provider",
        "latency_window_minutes": 10
      },
      "lowest_cost": {
        "description": "Route to cheapest provider for request",
        "include_quality_factor": true
      },
      "highest_success_rate": {
        "description": "Route to most reliable provider",
        "success_window_minutes": 60
      },
      "intelligent_hybrid": {
        "description": "Balance cost, latency, quality, and reliability",
        "weights": {
          "cost": 0.3,
          "latency": 0.3,
          "quality": 0.2,
          "reliability": 0.2
        }
      }
    }
  },
  "quality_thresholds": {
    "legal_analysis": 0.95,
    "customer_service": 0.8,
    "content_generation": 0.85,
    "code_generation": 0.9,
    "data_analysis": 0.9,
    "general": 0.7
  },
  "task_model_mapping": {
    "legal_analysis": {
      "preferred": ["claude-3-5-sonnet-20241022", "gpt-4o"],
      "fallback": ["gpt-4-turbo", "claude-3-opus-20240229"],
      "quality_threshold": 0.95
    },
    "customer_service": {
      "preferred": ["gpt-3.5-turbo", "claude-3-haiku-20240307"],
      "fallback": ["gpt-4o", "claude-3-5-sonnet-20241022"],
      "quality_threshold": 0.8
    },
    "content_generation": {
      "preferred": ["gpt-4o", "claude-3-opus-20240229"],
      "fallback": ["gpt-4-turbo", "claude-3-5-sonnet-20241022"],
      "quality_threshold": 0.85
    },
    "code_generation": {
      "preferred": ["gpt-4o", "gpt-4-turbo"],
      "fallback": ["claude-3-5-sonnet-20241022"],
      "quality_threshold": 0.9
    }
  }
}